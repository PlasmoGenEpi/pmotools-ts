{
  "name": "pmotools-ts",
  "version": "0.2.0",
  "description": "Build, validate, read and write Portable Microhaplotype Object (PMO) files in TypeScript",
  "keywords": [
    "pmo",
    "portable microhaplotype object",
    "microhaplotype",
    "malaria",
    "plasmodium",
    "genomics",
    "amplicon sequencing"
  ],
  "homepage": "https://github.com/PlasmoGenEpi/pmotools-ts#readme",
  "bugs": {
    "url": "https://github.com/PlasmoGenEpi/pmotools-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlasmoGenEpi/pmotools-ts.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "oracle": "cd conformance && .venv/bin/python -m oracle.run_all",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
